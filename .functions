#!/usr/bin/env bash

## mkd foo/bar - create directory and cd into it
function mkd() {
	# shellcheck disable=SC2164
	mkdir -p "$@" && cd "$_";
}

## cdf - cd to the current Finder window
function cdf() {
	# shellcheck disable=SC2164
	cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
}

# Normalize `open` across Linux, macOS, and Windows.
if [[ $OSTYPE != darwin* ]]; then
	if grep -q Microsoft /proc/version 2>/dev/null; then
		alias open='explorer.exe';
	else
		alias open='xdg-open';
	fi
fi

## o [file] - open file or current dir in Finder
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

## tre [path] - tree view with git awareness
function tre() {
	if command -v eza >/dev/null 2>&1; then
		eza -lahT --git --git-ignore --group-directories-first --ignore-glob='.git' "$@";
	else
		tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
	fi;
}


## fs [file|dir] - show size of file or directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$*" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

## duh [path] - sorted directory sizes
function duh() {
	du -h -d 1 "$@" | sort -h;
}

## targz files... - create .tar.gz archive
function targz() {
	local tmpFile="${*%/}.tar";
	tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1;

	size=$(
		stat -f"%z" "${tmpFile}" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}" 2> /dev/null;  # GNU `stat`
	);

	local cmd="";
	if (( size < 52428800 )) && hash zopfli 2> /dev/null; then
		cmd="zopfli";
	else
		if hash pigz 2> /dev/null; then
			cmd="pigz";
		else
			cmd="gzip";
		fi;
	fi;

	echo "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…";
	"${cmd}" -v "${tmpFile}" || return 1;
	[ -f "${tmpFile}" ] && rm "${tmpFile}";

	zippedSize=$(
		stat -f"%z" "${tmpFile}.gz" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}.gz" 2> /dev/null; # GNU `stat`
	);

	echo "${tmpFile}.gz ($((zippedSize / 1000)) kB) created successfully.";
}

## gz file - compare original vs gzipped size
function gz() {
	# shellcheck disable=SC2155
	local origsize=$(wc -c < "$1");
	# shellcheck disable=SC2155
	local gzipsize=$(gzip -c "$1" | wc -c);
	# shellcheck disable=SC2155
	local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l);
	printf "orig: %d bytes\n" "$origsize";
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio";
}

## dataurl file - create base64 data URL
function dataurl() {
	# shellcheck disable=SC2155
	local mimeType=$(file -b --mime-type "$1");
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8";
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')";
}

## server [dir] [port] - start HTTP server (default: . on 8000)
function server() {
	if [ -d "$1" ]; then
		local dir="$1"
		local port="${2:-8000}"
	elif [[ "$1" =~ ^[0-9]+$ ]]; then
		local port="$1"
		local dir="."
	else
		echo "Invalid directory"
		return
	fi

	echo "Serving $dir on http://localhost:$port"
	python3 -m http.server "$port" --directory "$dir"
}

## digga example.com - DNS lookup with all records
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer;
}

## getcertnames domain - show SSL certificate names (CN and SANs)
function getcertnames() {
	if [ -z "${1}" ]; then
		echo "ERROR: No domain specified.";
		return 1;
	fi;

	local domain="${1}";
	echo "Testing ${domain}…";
	echo "";

	# shellcheck disable=SC2155
	local tmp=$(echo -e "GET / HTTP/1.0\nEOT" \
		| openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1);

	if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
		# shellcheck disable=SC2155
		local certText=$(echo "${tmp}" \
			| openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
			no_serial, no_sigdump, no_signame, no_validity, no_version");
		echo "Common Name:";
		echo "";
		echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//";
		echo "";
		echo "Subject Alternative Name(s):";
		echo "";
		echo "${certText}" | grep -A 1 "Subject Alternative Name:" \
			| sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2;
		return 0;
	else
		echo "ERROR: Certificate not found.";
		return 1;
	fi;
}

## killport 3000 - kill process on a port
function killport() {
	local pids=$(lsof -ti:"$1" 2>/dev/null)
	if [[ -z "$pids" ]]; then
		echo "No process on port $1"
		return 1
	fi
	echo "$pids" | xargs kill -9 && echo "Killed process(es) on port $1"
}

## fkill - fuzzy search and kill processes
function fkill() {
	ps aux | fzf --header-lines=1 --multi | awk '{print $2}' | xargs kill -9
}

# Use Git's colored diff when available
if hash git &>/dev/null; then
	function diff() {
		git diff --no-index --color-words "$@";
	}
fi

## fquick - fuzzy search all aliases and functions
# shellcheck disable=SC2016,SC2086,SC2296
function fquick() {
	{
		builtin alias | sed 's/^/[alias] /'
		print -l ${(k)functions} | sed 's/^/[func]  /'
	} | fzf --preview 'word=$(echo {} | awk "{print \$2}" | cut -d= -f1); type $word 2>/dev/null || builtin alias $word 2>/dev/null'
}

## falias - fuzzy search aliases, copy to clipboard
function falias() {
	builtin alias | fzf --preview 'echo {}' | cut -d= -f1 | tr -d "\n" | pbcopy
}

# Show a random alias or function tip (only ones with ## comments)
function _shell_tip() {
	local -a tips
	local comment=""

	# Parse aliases (only ## comments)
	while IFS= read -r line; do
		if [[ $line == \#\#* ]]; then
			comment="${line#\#\# }"
		elif [[ $line == alias\ * && -n $comment ]]; then
			tips+=("$comment")
			comment=""
		else
			[[ -n $line ]] && comment=""
		fi
	done < ~/.aliases

	# Parse functions (only ## comments)
	while IFS= read -r line; do
		if [[ $line == \#\#* ]]; then
			comment="${line#\#\# }"
		elif [[ $line == function\ * && -n $comment ]]; then
			tips+=("$comment")
			comment=""
		else
			[[ -n $line ]] && comment=""
		fi
	done < ~/.functions

	(( ${#tips[@]} )) && print "Tip: ${tips[RANDOM % ${#tips[@]} + 1]}"
}
