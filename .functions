# Shared shell functions. Zsh is the primary interactive shell; keep non-interactive helpers portable.

## mkd foo/bar - create directory and cd into it
function mkd() {
	# shellcheck disable=SC2164
	mkdir -p "$@" && cd "$_";
}

if [[ $- == *i* ]]; then
	## cdf - cd to the current Finder window
	function cdf() {
		# shellcheck disable=SC2164
		cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
	}

	# Normalize `open` across Linux, macOS, and Windows.
	if [[ $OSTYPE != darwin* ]]; then
		if grep -q Microsoft /proc/version 2>/dev/null; then
			alias open='explorer.exe';
		else
			alias open='xdg-open';
		fi
	fi

	## o [file] - open file or current dir in Finder
	function o() {
		if [ $# -eq 0 ]; then
			open .;
		else
			open "$@";
		fi;
	}

	## tre [path] - tree view with git awareness
	function tre() {
		if command -v eza >/dev/null 2>&1; then
			eza -lahT --git --git-ignore --group-directories-first --ignore-glob='.git' "$@";
		else
			tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
		fi;
	}
fi

## fs [file|dir] - show size of file or directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$*" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

## duh [path] - sorted directory sizes
function duh() {
	du -h -d 1 "$@" | sort -h;
}

## targz files... - create .tar.gz archive
function targz() {
	local tmpFile="${*%/}.tar"
	tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1

	# shellcheck disable=SC2155
	local size=$(stat -f"%z" "${tmpFile}" 2>/dev/null || stat -c"%s" "${tmpFile}")
	local cmd="gzip"
	if (( size < 52428800 )) && hash zopfli 2>/dev/null; then cmd="zopfli"
	elif hash pigz 2>/dev/null; then cmd="pigz"; fi

	echo "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…"
	"${cmd}" -v "${tmpFile}" || return 1
	[ -f "${tmpFile}" ] && rm "${tmpFile}"

	# shellcheck disable=SC2155
	local zippedSize=$(stat -f"%z" "${tmpFile}.gz" 2>/dev/null || stat -c"%s" "${tmpFile}.gz")
	echo "${tmpFile}.gz ($((zippedSize / 1000)) kB) created successfully."
}

## compsize file - compare original vs compressed sizes (gzip, brotli, zstd)
function compsize() {
	local origsize
	origsize=$(wc -c < "$1");
	printf "orig: %d bytes\n" "$origsize";

	local formats=("gzip -c" "brotli -c" "zstd -c")
	local names=("gzip" "brotli" "zstd")

	for i in {0..2}; do
		local cmd="${formats[$i]%% *}"
		if command -v "$cmd" >/dev/null 2>&1; then
			local size
			size=$(${formats[$i]} "$1" 2>/dev/null | wc -c);
			local ratio
			ratio=$(echo "$size * 100 / $origsize" | bc -l);
			printf "%s: %d bytes (%2.2f%%)\n" "${names[$i]}" "$size" "$ratio";
		fi
	done
}

## dataurl file - create base64 data URL
function dataurl() {
	# shellcheck disable=SC2155
	local mimeType=$(file -b --mime-type "$1");
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8";
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')";
}

## serve [-cors] [--public|--host host] [dir] [port] - start HTTP server (default: 127.0.0.1:. on 8000)
function serve() {
	local usage="Usage: serve [-cors] [--public|--host host] [dir] [port]"
	local cors=false
	local host="127.0.0.1"
	local dir="."
	local port=8000
	local url_host

	while (( $# )); do
		case "$1" in
			-cors|--cors)
				cors=true
				;;
			--public)
				host="0.0.0.0"
				;;
			--host)
				shift
				[[ -n "${1:-}" ]] || { echo "$usage"; return 1; }
				host="$1"
				;;
			--help|-h)
				echo "$usage"
				return 0
				;;
			*)
				if [[ -d "$1" && "$dir" == "." ]]; then
					dir="$1"
				elif [[ "$1" =~ ^[0-9]+$ && "$port" == "8000" ]]; then
					port="$1"
				else
					echo "$usage"; return 1
				fi
				;;
		esac
		shift
	done

	[[ -d "$dir" ]] || {
		echo "Directory not found: $dir"
		return 1
	}

	[[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || {
		echo "Port must be between 1 and 65535"
		return 1
	}

	url_host="$host"
	[[ "$host" == "0.0.0.0" ]] && url_host="localhost"

	if $cors; then
		echo "Serving $dir on http://$url_host:$port (bound to $host, with CORS)"
		SERVE_DIR="$dir" SERVE_HOST="$host" SERVE_PORT="$port" python3 - <<'PY'
import os
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

directory = os.environ["SERVE_DIR"]
host = os.environ["SERVE_HOST"]
port = int(os.environ["SERVE_PORT"])


class CORSRequestHandler(SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "*")
        self.send_header("Access-Control-Allow-Headers", "*")
        super().end_headers()


handler = partial(CORSRequestHandler, directory=directory)
ThreadingHTTPServer((host, port), handler).serve_forever()
PY
	else
		echo "Serving $dir on http://$url_host:$port (bound to $host)"
		python3 -m http.server "$port" --bind "$host" --directory "$dir"
	fi
}

## digga example.com - DNS lookup with all records
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer;
}

## getcertnames domain - show SSL certificate names (CN and SANs)
function getcertnames() {
	[[ -z "$1" ]] && echo "ERROR: No domain specified." && return 1
	local domain="$1"
	echo -e "Testing ${domain}…\n"

	# shellcheck disable=SC2155
	local tmp=$(echo -e "GET / HTTP/1.0\nEOT" \
		| openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1);

	if [[ "${tmp}" != *"-----BEGIN CERTIFICATE-----"* ]]; then
		echo "ERROR: Certificate not found." && return 1
	fi
	# shellcheck disable=SC2155
	local certText=$(echo "${tmp}" \
		| openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
		no_serial, no_sigdump, no_signame, no_validity, no_version")
	echo -e "Common Name:\n"
	echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" -e "s/\/emailAddress=.*//"
	echo -e "\nSubject Alternative Name(s):\n"
	echo "${certText}" | grep -A 1 "Subject Alternative Name:" \
		| sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2
}

_kill_wait_seconds() {
	local wait_seconds="${1:-3}"
	[[ "$wait_seconds" =~ ^[1-5]$ ]] || {
		echo "Wait time must be an integer from 1 to 5 seconds" >&2
		return 1
	}
	printf '%s\n' "$wait_seconds"
}

_print_processes() {
	(( $# )) || return 0
	local -a ps_args=()
	local pid

	for pid in "$@"; do
		ps_args+=(-p "$pid")
	done

	ps -o pid=,command= "${ps_args[@]}" 2>/dev/null || printf '  pid %s\n' "$@"
}

_kill_with_timeout() {
	local wait_seconds="$1"
	shift

	local -a pids=("$@")
	local -a alive=()
	local pid elapsed

	(( ${#pids[@]} )) || return 1

	printf 'Sending SIGTERM to %s process(es)...\n' "${#pids[@]}"
	kill "${pids[@]}" 2>/dev/null || true

	for (( elapsed = 0; elapsed < wait_seconds; elapsed++ )); do
		alive=()
		for pid in "${pids[@]}"; do
			kill -0 "$pid" 2>/dev/null && alive+=("$pid")
		done

		(( ${#alive[@]} == 0 )) && {
			printf 'Stopped cleanly within %ss.\n' "$wait_seconds"
			return 0
		}

		sleep 1
	done

	alive=()
	for pid in "${pids[@]}"; do
		kill -0 "$pid" 2>/dev/null && alive+=("$pid")
	done

	if (( ${#alive[@]} )); then
		printf 'Still running after %ss. Sending SIGKILL to:\n' "$wait_seconds"
		_print_processes "${alive[@]}"
		kill -KILL "${alive[@]}" 2>/dev/null || true
		sleep 0.2
	fi

	alive=()
	for pid in "${pids[@]}"; do
		kill -0 "$pid" 2>/dev/null && alive+=("$pid")
	done

	if (( ${#alive[@]} )); then
		echo "Unable to stop all processes:"
		_print_processes "${alive[@]}"
		return 1
	fi

	echo "Stopped."
}

## killport 3000 [wait_seconds] - stop process on a port, then force after timeout
function killport() {
	local port="$1"
	local wait_seconds
	local -a pids=()
	local pid

	[[ -n "$port" && "$port" =~ ^[0-9]+$ ]] || {
		echo "Usage: killport PORT [wait_seconds]"
		return 1
	}

	wait_seconds=$(_kill_wait_seconds "${2:-3}") || return 1

	while IFS= read -r pid; do
		[[ -n "$pid" ]] && pids+=("$pid")
	done < <(lsof -ti:"$port" 2>/dev/null | sort -u)

	(( ${#pids[@]} )) || {
		echo "No process on port $port"
		return 1
	}

	printf 'Processes on port %s:\n' "$port"
	_print_processes "${pids[@]}"
	_kill_with_timeout "$wait_seconds" "${pids[@]}"
}

if [[ $- == *i* ]]; then
	## fkill [wait_seconds] - fuzzy search and stop processes, then force after timeout
	function fkill() {
		local wait_seconds
		local selection
		local -a pids=()
		local pid

		wait_seconds=$(_kill_wait_seconds "${1:-3}") || return 1
		selection=$(ps aux | fzf --header-lines=1 --multi) || return 1

		while IFS= read -r pid; do
			[[ -n "$pid" ]] && pids+=("$pid")
		done < <(printf '%s\n' "$selection" | awk 'NF { print $2 }' | sort -u)

		(( ${#pids[@]} )) || return 1

		echo "Selected processes:"
		printf '%s\n' "$selection"
		_kill_with_timeout "$wait_seconds" "${pids[@]}"
	}

	# Use Git's colored diff when available
	if hash git &>/dev/null; then
		function diff() {
			git diff --no-index --color-words "$@";
		}
	fi

	## fquick - fuzzy search all aliases and functions
	# shellcheck disable=SC2016,SC2086,SC2296
	function fquick() {
		{
			builtin alias | sed 's/^/[alias] /'
			print -l ${(k)functions} | sed 's/^/[func]  /'
		} | fzf --preview 'word=$(echo {} | awk "{print \$2}" | cut -d= -f1); type $word 2>/dev/null || builtin alias $word 2>/dev/null'
	}

	## falias - fuzzy search aliases, copy to clipboard
	function falias() {
		builtin alias | fzf --preview 'echo {}' | cut -d= -f1 | tr -d "\n" | pbcopy
	}
fi

## epoch [-ms|-ns] - get current Unix timestamp in seconds (default), milliseconds, or nanoseconds
function epoch() {
	local ts
	ts=$(date +%s)
	case "$1" in
		-ms)
			echo $((ts * 1000))
			;;
		-ns)
			echo $((ts * 1000000000))
			;;
		*)
			echo "$ts"
			;;
	esac
}

# Normalize ms/ns timestamps to seconds
_ts_to_secs() {
	local ts="$1" len=${#1}
	if [[ $len -eq 13 ]]; then echo $((ts / 1000))
	elif [[ $len -ge 16 ]]; then echo $((ts / 1000000000))
	else echo "$ts"; fi
}

## ts2date 1609459200 - convert unix timestamp to human readable (handles ms/ns)
function ts2date() {
	[[ -z "$1" ]] && return 1
	local ts; ts=$(_ts_to_secs "$1")
	date -d "@$ts" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || date -r "$ts" "+%Y-%m-%d %H:%M:%S"
}

## date2ts "2021-01-01" - convert date string to unix timestamp (accepts many formats)
function date2ts() {
	[[ -z "$1" ]] && return 1
	date -d "$1" +%s 2>/dev/null || \
		date -j -f "%Y-%m-%d" "$1" +%s 2>/dev/null || \
		date -j -f "%Y-%m-%d %H:%M:%S" "$1" +%s 2>/dev/null
}

## timeago 1609459200 - show how long ago a timestamp was (handles ms/ns)
function timeago() {
	[[ -z "$1" ]] && return 1
	local ts; ts=$(_ts_to_secs "$1")
	local diff=$(( $(date +%s) - ts ))
	local abs=$(( diff < 0 ? -diff : diff ))

	local d=$((abs / 86400)) h=$(((abs % 86400) / 3600))
	local m=$(((abs % 3600) / 60)) s=$((abs % 60))

	local result=""
	((d > 0)) && result="${d}d"
	((h > 0)) && result="${result}${h}h"
	((m > 0)) && result="${result}${m}m"
	[[ $s -gt 0 || -z "$result" ]] && result="${result}${s}s"

	((diff < 0)) && echo "$result in the future" || echo "$result ago"
}

if [[ $- == *i* ]]; then
	## dsh - docker shell into running container with fzf
	function dsh() {
		docker exec -it "$(docker ps --format '{{.Names}}' | fzf)" sh;
	}

	# rm files... - move to Trash instead of deleting (use \rm for real delete)
	rm() {
		local trash="$HOME/.Trash"
		local f
		for f in "$@"; do
			[[ "$f" == -* ]] && continue
			[[ -e "$f" ]] && mv "$f" "$trash/$(basename "$f")_$(date +%s)"
		done
	}
fi

# Collect ## doc-comments preceding lines matching a keyword from a file.
# Usage: _collect_tips tips_array keyword file
_collect_tips() {
	local -n _tips_ref=$1
	local keyword="$2" file="$3"
	local comment="" line

	while IFS= read -r line; do
		if [[ $line == \#\#* ]]; then
			comment="${line#\#\# }"
		elif [[ -n $comment && $line == "$keyword "* ]]; then
			_tips_ref+=("$comment")
			comment=""
		else
			[[ -n $line ]] && comment=""
		fi
	done < "$file"
}

# Show a random alias or function tip (only ones with ## comments)
# shellcheck disable=SC2053
function _shell_tip() {
	local -a tips
	_collect_tips tips "alias" ~/.aliases
	_collect_tips tips "function" ~/.functions

	if (( ${#tips[@]} )); then
		print "Tip: ${tips[RANDOM % ${#tips[@]} + 1]}"
		return 0
	fi

	return 1
}
