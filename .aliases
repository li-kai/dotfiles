# Interactive shell aliases. Zsh is the primary target; bash loads this file only in interactive sessions.

if [[ $- == *i* ]]; then

# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~" # `cd` is probably faster to type though
alias -- -="cd -"

# Shortcuts
alias cc="claude --disallowedTools \"EnterPlanMode,ExitPlanMode,EnterWorktree,ExitWorktree,NotebookEdit,CronCreate,CronDelete,CronList,ScheduleWakeup,SendMessage,TeamCreate,TeamDelete,Workflow\""
alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"
alias g="git"

# l: list files (long format)
# la: list all files including hidden
# lsd: list directories only
if command -v eza >/dev/null 2>&1; then
	alias ls='eza -b --time-style=iso';
	alias l='ls -lhF --git'
	alias la='ls -lahF --git'
	alias lsd='ls -lhF --git --only-dirs'
elif ls --color > /dev/null 2>&1; then # GNU `ls`
	export LS_COLORS='no=00:fi=00:di=01;31:ln=01;36:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:ex=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.bz2=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.avi=01;35:*.fli=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.ogg=01;35:*.mp3=01;35:*.wav=01;35:'
	alias ls="command ls --color"
	alias l="ls -lF"
	alias la="ls -lAF"
	alias lsd="ls -lF | grep --color=never '^d'"
else # macOS `ls`
	export LSCOLORS='BxBxhxDxfxhxhxhxhxcxcx'
	alias ls="command ls -G"
	alias l="ls -lF"
	alias la="ls -lAF"
	alias lsd="ls -lF | grep --color=never '^d'"
fi

# Replace grep with ripgrep
# alias grep='grep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn,.idea,.tox,.venv,venv}'
# alias egrep='egrep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn,.idea,.tox,.venv,venv}'
# alias fgrep='fgrep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn,.idea,.tox,.venv,venv}'

# Replace `cat` with `bat`
if command -v bat >/dev/null 2>&1; then
	alias cat='bat'
fi

# Clipboard (macOS)
alias copy='pbcopy'
alias paste='pbpaste'

# Enable aliases to be sudo’ed
alias sudo='sudo '

## week - get current week number
alias week='date +%V'

## ip - get your public IP address
alias ip="curl -s --max-time 2 ifconfig.me || dig +short myip.opendns.com @resolver1.opendns.com"
alias localip="ipconfig getifaddr en0"
alias ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Show active network interfaces
alias ifactive="ifconfig | pcregrep -M -o '^[^\t:]+:([^\n]|\n\t)*status: active'"

## flush - flush DNS cache
alias flush="dscacheutil -flushcache && killall -HUP mDNSResponder"

# Clean up LaunchServices to remove duplicates in the “Open With” menu
alias lscleanup="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -kill -r -domain local -domain system -domain user && killall Finder"

# Canonical hex dump; some systems have this symlinked
command -v hd > /dev/null || alias hd="hexdump -C"

# macOS has no `md5sum`, so use `md5` as a fallback
command -v md5sum > /dev/null || alias md5sum="md5"

# macOS has no `sha1sum`, so use `shasum` as a fallback
command -v sha1sum > /dev/null || alias sha1sum="shasum"

## c - pipe to trim newlines and copy to clipboard
alias c="tr -d '\n' | pbcopy"

## emptytrash - empty Trash, system logs, and quarantine history
alias emptytrash="sudo rm -rfv /Volumes/*/.Trashes; sudo rm -rfv ~/.Trash; sudo rm -rfv /private/var/log/asl/*.asl; sqlite3 ~/Library/Preferences/com.apple.LaunchServices.QuarantineEventsV* 'delete from LSQuarantineEvent'"

## mergepdf a.pdf b.pdf - merge PDFs into _merged.pdf
alias mergepdf='gs -q -dNOPAUSE -dBATCH -sDEVICE=pdfwrite -sOutputFile=_merged.pdf'

# PlistBuddy alias, because sometimes `defaults` just doesn’t cut it
alias plistbuddy="/usr/libexec/PlistBuddy"

# Reload the shell (invoke as login shell)
alias reload='exec ${SHELL} -l'

## path - print each PATH entry on a separate line
alias path='echo -e ${PATH//:/\\n}'

alias python='python3'

alias nvm='fnm'

## ports - show listening ports
alias ports='lsof -i -P -n | grep LISTEN'

## isotime - get ISO 8601 timestamp
alias isotime='date -u +"%Y-%m-%dT%H:%M:%SZ"'

alias timestamp='epoch'

fi
