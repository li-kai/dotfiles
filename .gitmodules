[submodule ".config/oh-my-zsh/plugins/zsh-syntax-highlighting"]
	path = .config/oh-my-zsh/plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
[submodule ".config/oh-my-zsh/plugins/zsh-autosuggestions"]
	path = .config/oh-my-zsh/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions.git
[submodule ".config/oh-my-zsh/themes/geometry"]
	path = .config/oh-my-zsh/themes/geometry
	url = https://github.com/geometry-zsh/geometry.git
