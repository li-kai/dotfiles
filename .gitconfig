[alias]

	# View abbreviated SHA, description, and history graph of the latest 20 commits.
	l = !"git --no-pager log --pretty=oneline -n 20 --graph --abbrev-commit"

	# Better git status
	s = status --short --branch

	# Show the diff between the latest commit and the current state.
	d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"

	# `git di $number` shows the diff between the state `$number` revisions ago and the current state.
	di = !"d() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD -- || clear; d"

	# Pull in remote changes for the current repository and all its submodules.
	p = pull --recurse-submodules

	# Clone a repository including all submodules.
	c = clone --recursive

	# Commit all changes.
	ca = !git add ':(exclude,attr:builtin_objectmode=160000)' && git commit -av

	# Switch to a branch, creating it if necessary.
	go = "!f() { git checkout -b \"$1\" 2> /dev/null || git checkout \"$1\"; }; f"

	# Show verbose output about tags, branches or remotes
	tags = tag -l
	branches = branch --all
	remotes = remote --verbose

	# List aliases.
	aliases = config --get-regexp alias

	# Amend the currently staged files to the latest commit.
	amend = commit --amend --reuse-message=HEAD

	# Edit last commit message
	reword = commit --amend

	# Undo last commit but keep changed files in stage
	uncommit = reset --soft HEAD~1

	# Credit an author on the latest commit.
	credit = "!f() { git commit --amend --author \"$1 <$2>\" -C HEAD; }; f"

	# Interactive rebase with the given number of latest commits.
	reb = "!r() { git rebase -i HEAD~$1; }; r"

	# Convenient wip commit
	wip = "!git add -A && git commit -m \"Add WIP savepoint\""

	# Remove the old tag with this name and tag the latest commit with it.
	retag = "!r() { git tag -d $1 && git push origin :refs/tags/$1 && git tag $1; }; r"

	# Find branches containing commit
	fb = "!f() { git branch -a --contains $1; }; f"

	# Find tags containing commit
	ft = "!f() { git describe --always --contains $1; }; f"

	# Find commits by source code
	fc = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"

	# Find commits by commit message
	fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"

	# Remove branches that have already been merged with main.
	# a.k.a. ‘delete merged’
	dm = "!git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"

	# List contributors with number of commits.
	contributors = shortlog --summary --numbered

	# Show the user email for the current repository.
	whoami = config user.email

	# Fuzzy switch to a branch.
	sw = "!git branch -a --sort=-committerdate --format='%(refname:short)' | fzf --preview 'git log --oneline -20 {}' | sed 's#^origin/##' | xargs -I {} git switch {}"

	# Clean up merged branches (both regular and squash-merged).
	superprune = "!f() { \
		echo 'Fetching and pruning...'; \
		git fetch --prune; \
		echo ''; \
		echo 'Deleting merged local branches...'; \
		git branch --merged | grep -vE '^\\*|^\\s*(main|master|develop|staging)$' | xargs -r git branch -d; \
		echo ''; \
		echo 'Deleting branches with deleted upstream (squash-merged)...'; \
		git branch -vv | grep ': gone]' | grep -vE '^\\*|^\\s*(main|master|develop|staging)\\s' | awk '{print $1}' | xargs -r git branch -D; \
		echo ''; \
		echo 'Done!'; \
	}; f"

	# Alias for superprune.
	clean = "!git superprune"

	# Safer force push (use --force-with-lease + --force-if-includes).
	pushf = push --force-with-lease --force-if-includes

	# Claude worktree
	cwt = "!f() { \
		toplevel=\"$(git rev-parse --show-toplevel)\" && \
		dest=\"$toplevel/../$1\" && \
		(git worktree add \"$dest\" \"$1\" 2>/dev/null || git worktree add -b \"$1\" \"$dest\" \"${2:-HEAD}\") && \
		mkdir -p \"$dest/.claude\" && \
		ln -sf \"$toplevel/.claude/settings.local.json\" \"$dest/.claude/settings.local.json\" && \
		echo \"Worktree ready. Run:\\n  cd $dest\"; \
	}; f"

[apply]

	# Detect whitespace errors when applying a patch.
	whitespace = fix

[branch]

	# Show most recently changed branches first.
	sort = -committerdate

[submodule]

	# Automatically initialize and update submodules when cloning or pulling.
	recurse = true

[core]

	# Use custom `.gitignore` and `.gitattributes`.
	excludesfile = ~/.gitignore
	attributesfile = ~/.gitattributes

	# Treat spaces before tabs and all kinds of trailing whitespace as an error.
	# [default] trailing-space: looks for spaces at the end of a line
	# [default] space-before-tab: looks for spaces before tabs at the beginning of a line
	whitespace = space-before-tab, trailing-space

	# Make `git rebase` safer on macOS.
	# More info: <http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/>
	trustctime = false

	# Prevent showing files whose names contain non-ASCII symbols as unversioned.
	# http://michael-kuehnel.de/git/2014/11/21/git-mac-osx-and-german-umlaute.html
	precomposeunicode = false

	# Speed up commands involving untracked files such as `git status`.
	# https://git-scm.com/docs/git-update-index#_untracked_cache
	untrackedCache = true

[color]

	# Use colors in Git commands that are capable of colored output when
	# outputting to the terminal. (This is the default setting in Git ≥ 1.8.4.)
	ui = auto

[color "branch"]

	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]

	meta = yellow bold
	frag = magenta bold # line info
	old = red # deletions
	new = green # additions

[color "status"]

	added = yellow
	changed = green
	untracked = cyan

[commit]

	# https://help.github.com/articles/signing-commits-using-gpg/
	gpgsign = true

[diff]

	# Use better, descriptive initials (c, i, w) instead of a/b.
	# c: commit, i: index, w: working tree, o: object
	mnemonicPrefix = true
	# Detect copies as well as renames.
	renames = copies
	# When using --word-diff, assume --word-diff-regex=.
	wordRegex = .
	# Display submodule-related information (commit listings)
	submodule = log
	# Try to be smarter about whitespace changes.
	indentHeuristic = true
	# Use the best diff algorithm by default.
	algorithm = histogram

[diff "bin"]

	# Use `hexdump` to diff binary files.
	textconv = hexdump -v -C

[help]

	# Automatically correct and execute mistyped commands.
	autocorrect = 1

[merge]

	# Autostash changes before rebasing
	autoStash = true
	# Include summaries of merged commits in newly created merge commit messages
	log = true

[rebase]

	# Autostash changes before rebasing
	autoStash = true
	# e.g. Use 'p' instead of 'pick' when rebasing
	abbreviateCommands = true
	# Automatically arrange fixup!/squash! commits in interactive rebase
	autoSquash = true

[rerere]

	# Reuse Recorded Resolution - remember how you resolved merge conflicts
	enabled = true
	# Automatically stage files after rerere resolves conflicts
	autoupdate = true

[column]

	# Better formatting for branch/tag lists
	ui = auto

[fetch]

	# Always prune while fetching and pulling
	prune = true
	# Same thing with tags
	pruneTags = true
	# Fetch in parallel
	parallel = 0
	# Write commit-graph on fetch for faster git log
	writeCommitGraph = true

[push]

	# https://git-scm.com/docs/git-config#Documentation/git-config.txt-pushdefault
	default = current
	# Make `git push` push relevant annotated tags when pushing branches out.
	followTags = true
	autoSetupRemote = true

# URL shorthands

[url "git@github.com:"]

	insteadOf = "gh:"
	pushInsteadOf = "github:"
	pushInsteadOf = "git://github.com/"

[url "git://github.com/"]

	insteadOf = "github:"

[url "git@gist.github.com:"]

	insteadOf = "gst:"
	pushInsteadOf = "gist:"
	pushInsteadOf = "git://gist.github.com/"

[url "git://gist.github.com/"]

	insteadOf = "gist:"

[init]

	defaultBranch = main

[pull]
	ff = only
	rebase = true

[gpg]
	format = ssh

[include]

	# Machine-specific config (user, signing key, maintenance) - not committed
	path = ~/.gitconfig.local
